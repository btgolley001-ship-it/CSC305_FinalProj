doctype html
html
  head
    title Teacher Page
  body
    h1 Teacher Page
    p Your ID: #{id}

block content 

    h2 Your Offerings

    if coursesTeaching.length === 0
      p No enrollment records
    else
      table(border="1" cellpadding="6")
        tr
          th Course Number
          th Term
          th Year
        each row in coursesTeaching
          tr
            td= row.CourseNo
            td= row.OffTerm
            td= row.OffYear
            td
              form(action="/role" method="POST")
                input(type="hidden" name="id" value=id)
                input(type="hidden" name="role" value="teacher")
                input(type="hidden" name="course_to_grade" value=row.CourseNo)
                button(type="submit") Grade Students

    if stdInfo 
      h2 Your Students
      if stdInfo.length === 0
        p No students enrolled
      else
        table(border="1" cellpadding="6")
          tr
            th Student
            th Student ID
            th Grade
          each row in stdInfo
            tr
              td= row.Student
              td= row.StdSSN
              td
                form(action="/role" method="POST")
                  input(type="hidden" name="id" value=id)
                  input(type="hidden" name="role" value="teacher")
                  input(type="hidden" name="student_ssn" value=row.StdSSN)
                  input(type="hidden" name="course_to_grade" value=course_to_grade)
                  input(type="text" name="student_grade" value= row.Days placeholder=row.EnrGrade)
                  button(type="submit") Submit Grade