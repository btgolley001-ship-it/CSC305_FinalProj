doctype html
html
  head
    title Registrar Page
  body
    h1 Registrar Page 
    p Your ID: #{id}
    h2 Winter 2025 Offerings
    table
      thead
        tr
          th Offering Number
          th Course Number
          th Instructor
          th Location
          th Time
          th Days
      tbody
        each row in WinterOfferings
          tr
            td= row.OfferNo
            td= row.CourseNo
            td= row.Instructor
            td= row.Location
            td= row.Time
            td= row.Days
            //Edit form (inline)
            form(action= `/registrar/${id}/edit_offering?offer_no=${row.OfferNo}` method='post' style="display:inline-block; margin-right:10px;")
              select(name="FacSSN")
                option(value="") --None--
                each f in facultyIDs
                  option(value=f.FacSSN selected=(f.FacSSN == row.FacSSN)) #{f.Instructor}
                input(type="text" name="location" value= row.Location placeholder="Location")
                input(type="text" name="time" value= row.Time placeholder="Time")
                input(type="text" name="days" value= row.Days placeholder="Days")
                label
                  input(type="checkbox" name="offered" checked=(row.OfferNo ? true : false))
                  | Offered
                button(type="submit") Update
            form(action=`/registrar/${id}/cancel_offering/${row.OfferNo}` method="post" style="display:inline-block")
              button(type="submit" onclick="return confirm('cancel offering?')") Cancel
    h2 Add new Winter 2025 Offerings
    form(action=`/registrar/${id}/add_offering` method="post")
      label Course:
      select(name="CourseNo")
        each row in courses
          option(value=row.CourseNo) #{row.CourseNo} 
      br
      label Offering Number:
      input(type="text" name="OfferNo" required)
      br
      label Instructor:
      select(name= "FacSSN")
        option(value="") --None--
        each f in facultyIDs
          option(value=f.FacSSN) #{f.Instructor}
      br 
      label Location:
      input(type="text" name="location")
      br 
      label Time:
      input(type="text" name="time")
      br 
      label Days:
      input(type="text" name="days")
      br
      button(type="submit") Add Offering
