doctype html
html
  head
    title Registrar Page
  body
    h1 Registrar Page 
    p Your ID: #{id}
    h2 Winter 2025 Offerings
    table
      thead
        tr
          th Offering Number
          th Course Number
          th Instructor
          th Location
          th Time
          th Days
      tbody
        each row in WinterOfferings
          tr
            td= row.OfferNo
            td= row.CourseNo
            form(action="/role" method="post" id="form-#{row.OfferNo}")
              // Instructor dropdown initialized to current instructor
              td
                select(name="FacSSN")
                  option(value="" selected=(row.FacSSN == null || row.FacSSN == '')) --None--
                  each f in facultyIDs
                    option(value=f.FacSSN selected=(f.FacSSN == row.FacSSN)) #{f.Instructor}
              // Location
              td
                input(type="text" name="Location_toUpdate" value=row.Location)
              // Time
              td
                input(type="text" name="Time_toUpdate" value=row.Time)
              // Days
              td
                input(type="text" name="Days_toUpdate" value=row.Days)

              td 
                input(type="checkbox" name="Offered" checked)
                label Offered

              td
                input(type="hidden" name="OfferNo_toUpdate" value=row.OfferNo)
                input(type="hidden" name="id" value=id)
                input(type="hidden" name="role" value="registrar")
                input(type="hidden" name="action" value="offering_update")
                button(type="submit") Update

    h2 Add new Winter 2025 Offerings
    form(action="/role" method="post")
      label Course:
      select(name="CourseNo_toAdd")
        each row in courses
          option(value=row.CourseNo) #{row.CourseNo} 
      br
      label Offering Number:
      input(type="text" name="OfferNo_toAdd" required)
      br
      label Instructor:
      select(name= "FacSSN_toAdd")
        option(value="") --None--
        each f in facultyIDs
          option(value=f.FacSSN) #{f.Instructor}
      br 
      label Location:
      input(type="text" name="Location_toAdd")
      br 
      label Time:
      input(type="text" name="Time_toAdd")
      br 
      label Days:
      input(type="text" name="Days_toAdd")
      br
      input(type="hidden" name="action" value="offering_add")
      input(type="hidden" name="id" value=id)
      input(type="hidden" name="role" value="registrar")
      button(type="submit") Add Offering
