doctype html
html
  head
    title Registrar Page
  body
    h1 Registrar Page 
    p Your ID: #{id}
    h2 Winter 2025 Offerings
    if offerings.length
      table
        thead
          tr
            th Offering#
            th Course No
            th Instructor
            th Location
            th Time
            th Days
        tbody
          each row in offerings
            tr
              td row.Offering
              td row.CourseNo
              td row.Instructor
              td row.Location
              td row.Time
              td row.Days
                //Edit form (inline)
                form(action= `/resistrar/${id}/edit_offering?${row.Offering}` method='post' style="display:inline-block; margin-right:10ox;")
                  select(name="teacher_id")
                    option(value="")--None--
                    each f in teacher
                      option(value=f.teacher_id selected=(f.faculty_id == o.teacher_id)) 
                    input(type="text" name"location" value= row.Location placeholder="Location")
                    input(type="text" name"time" value= row.Time placeholder="Time")
                    input(type="text" name"days" value= row.Days placeholder="Days")
                    label
                     input(type="checkbox" name"offered" checked=(row.Offerd ? true : false))
                     | Offered
                    button(type="submit") Update
                  form(action=`(action=`/registrar/${id}/cancel_offering/${row_Offering}` method="post" style="display:inline-block")
                    button(type="submit" onclick="return confirm('cancel offering?')") Cancel
    else
      p No offering schecduled for next term.
    h2 Add new Winter 2025 Offerings
    form(action=`/registrar/${id}/add_offering` method="post")
      label Course:
      select(name="course_no")
        each row in courses
          option(value=c.course_no) #{Row_CourseNo} 
        br
        label Offering #:
        input(type="text" name="offering_no" requiered)
        br
        label Instructor:
        select(name= "teacher_id")
          option(value="") --None--
          eache f in faculty
            option(value=t.teacher_id) 
        br 
        label location:
        input(type="text" name="location")
        br 
        label time:
        input(type="text" name="time")
        br 
        label days:
        input(type="text" name="days")
        br
        button(type="submit) Add Offering
     
      

